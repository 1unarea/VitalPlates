{
  "schemaVersion": 1,
  "id": "vitalplates",
  "version": "${version}",
  "name": "VitalPlates",
  "description": "Client-side Fabric mod for Minecraft 26.3 dynamically coloring nametags based on health percentage.",
  "authors": [
    "1unarea"
  ],
  "contact": {
    "homepage": "https://github.com/1unarea/vitalplates",
    "sources": "https://github.com/1unarea/vitalplates",
    "issues": "https://github.com/1unarea/vitalplates/issues"
  },
  "license": "MIT",
  "icon": "assets/vitalplates/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.vitalplates.VitalPlatesClient"
    ],
    "modmenu": [
      "org.vitalplates.client.gui.ModMenuIntegration"
    ]
  },
  "mixins": [
    "vitalplates.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.161.0+26.3",
    "minecraft": "~26.3",
    "java": ">=25"
  }
}
